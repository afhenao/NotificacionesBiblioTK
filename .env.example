# Copiar como .env (nunca subir el .env real)
PORT=3006

# Las mismas credenciales de BD de los demás backends (para validar la sesión)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=bibliotk
JWT_SECRET="JOA_VALE_CULE_MONDA_RARA"
# Redis: docker compose -f ../InfraBiblioTK/docker-compose.yml up -d redis
REDIS_URL=redis://localhost:6379

# Orígenes de los fronts que pueden abrir el socket con la cookie (uno por variable)
ALLOWED_ORIGIN_1=http://localhost:5172
ALLOWED_ORIGIN_2=http://localhost:5173
ALLOWED_ORIGIN_3=http://localhost:5174
ALLOWED_ORIGIN_4=http://localhost:5175

# Opcionales
# NOTIFICACIONES_CLAVE=   (si se define, también en los backends que publican)
# MOVIL_URL=http://192.168.1.2:5177/   (por defecto se detecta la IP de la red local)
# MOVIL_PUERTO=5177
# ZONA_HORARIA=America/Bogota
